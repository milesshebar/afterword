# The product's name for the build and install scripts (sourced by bundle.sh, release-app.sh, install-app.sh, selfcheck.sh).
# APP_EXECUTABLE must equal `productName` in Package.swift.
APP_NAME="Afterword"                            # what people read (CFBundleName, messages)
APP_EXECUTABLE="Afterword"                      # the binary and <APP_EXECUTABLE>.app
BUNDLE_ID="${BUNDLE_ID:-io.github.afterword}"   # reverse-DNS identifier; set BUNDLE_ID to your own when you sign builds
